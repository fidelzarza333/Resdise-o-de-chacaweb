.noticias{
    padding: clamp(20px, 6vh, 80px) clamp(30px, 10vw, 120px);
    .noticia-completa{
        padding: clamp(20px, 6vh, 80px) clamp(30px, 10vw, 120px);

        .noticia-inner{
            display: flex;
            flex-direction: column;
            box-shadow: 
            5px 5px 10px rgba(87, 41, 211, 0.1),
            10px 10px 20px rgba(87, 41, 211, 0.2);
            background: rgb(11, 16, 41);
            color: rgb(121, 134, 168);
            padding: 20px;
            border: 1px solid rgba(96, 165, 250, 0.5);
            border-radius: 20px;
            transition: transform 0.35s, border-color 0.35s;

            .arriba{
                display: flex;
                flex-direction: row;
                gap: 15px;
                padding: 15px;
                align-items: stretch;

                .izquierda{
                    flex: 1;

                    p{
                        margin-bottom:30px;
                    }
                }

                .derecha{
                    flex: 1;

                    .wrapper-img{
                        flex: 0 0 45%;
                        aspect-ratio: 16 / 9;
                        overflow: hidden;
                        
                        border-radius: 20px;
                        align-self: center;

                        img{
                            width: 100%;
                            height: 100%;
                            object-fit: cover;
                            display: block;
                        }
                    }
                }
            }

            .abajo{
                padding: 15px;
            }
        }
    }    
}